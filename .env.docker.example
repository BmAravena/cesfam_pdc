# Copiar este archivo a .env en la raíz del proyecto.
# La base de datos permanece en la nube; no se levanta PostgreSQL en Docker.

# URL de conexión entregada por el proveedor (Supabase u otro PostgreSQL).
# Mantener los parámetros de SSL/pooler que ya uses.
DATABASE_URL_POSTGRES=postgresql://usuario:clave@host:5432/postgres?sslmode=require

# Clave usada para firmar los JWT. Generar una nueva para producción.
SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria

DATABASE_ECHO=false

# Opcionales del despliegue
HTTP_PORT=80
RUN_MIGRATIONS=true
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=*
# El frontend usa /api/v1 por defecto; Nginx hace el proxy al backend.
VITE_API_URL=/api/v1

# Verificación de dominios de correo (cuentas internas)
# EMAIL_DNS_TIMEOUT=3.0
# EMAIL_DNS_CACHE_TTL=3600
# Permite el alta si DNS falla transitoriamente. Usar solo como medida temporal.
# EMAIL_VERIFICACION_FAIL_OPEN=false
